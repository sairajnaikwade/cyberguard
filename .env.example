# CyberGuard Environment Configuration Example
# Copy this file to '.env' and fill in your actual credentials.

# Flask settings
SECRET_KEY=change-this-to-a-secure-random-key-in-production
FLASK_DEBUG=true

# Database URI (Defaults to local SQLite)
# DATABASE_URL=postgresql://user:password@localhost:5432/cyberguard
DATABASE_URL=sqlite:///cyberguard.db

# Celery & Redis configuration
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_BROKER_URL=sqla+sqlite:///celery_broker.db
CELERY_RESULT_BACKEND=db+sqlite:///celery_results.db

# Shodan Threat Intelligence API Key (Optional)
SHODAN_API_KEY=

# SMTP Email Alert configuration (Optional)
SMTP_SERVER=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alerts@cyberguard.local
